# ── You ───────────────────────────────────────────────────────────
# Your first name, so JARVIS knows who it's talking to.
JARVIS_USER_NAME=

# Sports teams for the dashboard and "when do we play next?" (ESPN team ids).
# Format sport/league/team, comma-separated. Examples:
#   basketball/nba/gs  football/nfl/sf  baseball/mlb/nyy  hockey/nhl/bos
JARVIS_TEAMS=

# Optional: your school's Blackbaud assignment page (the → button on the dashboard).
# The assignments feed itself goes in tools/.env.local (see tools/.env.local.example).
JARVIS_BLACKBAUD_URL=

# Optional: your home printer. JARVIS_PRINTER = queue name from `lpstat -p`,
# JARVIS_PRINTER_MATCH = part of its name as it appears on Wi-Fi.
JARVIS_PRINTER=
JARVIS_PRINTER_MATCH=

# ── Voice ─────────────────────────────────────────────────────────
# kokoro     = free, on-device, unlimited (default; installed by setup.sh)
# elevenlabs = paid credits, needs ELEVENLABS_API_KEY below
JARVIS_TTS=kokoro
# Kokoro voice: bm_george, bm_lewis, bm_daniel, bm_fable (British) or
# am_michael, am_fenrir, am_adam (American), and more.
JARVIS_KOKORO_VOICE=bm_george
# Hearing: local = free on-device Whisper (default), elevenlabs = uses credits
JARVIS_STT=local
# Words speech-to-text should expect (names, places), comma-separated.
JARVIS_STT_HINTS=JARVIS, standby.

# Optional ElevenLabs (paid voice). Leave blank to use only the free voice.
ELEVENLABS_API_KEY=
# Any voice id from your account. Find them at http://localhost:8730/api/voices once running.
# This default is "George" — British, calm.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Runtime ───────────────────────────────────────────────────────
# Where Claude Code runs. User-scoped connectors work from anywhere.
JARVIS_WORKDIR=~

# bypass  = the assistant may use tools without asking (needed for
#           connectors to work headlessly — see the README)
# default = require approval (tools will stall in a headless run)
JARVIS_PERMISSION=bypass

# all  = load your Claude Code connectors (Gmail, Calendar, …)
# none = skip them, if one is hanging
JARVIS_MCP=all

# Kill a run that produces no output for this many seconds.
JARVIS_TIMEOUT=45

JARVIS_PORT=8730

# Don't pop a browser tab on start (the background listener does voice)
JARVIS_OPEN=0

# Pop-up hotkey: double-tap this key (ctrl, cmd, shift, fn, option)
JARVIS_HOTKEY=cmd

# Seconds to keep listening for a follow-up after an answer (0 = stop)
JARVIS_FOLLOWUP=0

# How sure the wake-word detector must be (0-1). Higher = fewer false wake-ups.
JARVIS_WAKE_THRESHOLD=0.65
